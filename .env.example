# Copy to .env. Never commit .env.
#
# Local Postgres from docker-compose.yml.
# If 5432 is taken, set BOTH to 5434 (example):
# DEALFLOW_DB_PORT=5434
# DATABASE_URL="postgresql://dealflow:dealflow@localhost:5434/dealflow?schema=public"
DEALFLOW_DB_PORT=5432
DATABASE_URL="postgresql://dealflow:dealflow@localhost:5432/dealflow?schema=public"

# Shared integration database: same URL for everyone but a per-developer schema,
# e.g. ?schema=dev_ruchir. Only Ruchir runs `prisma migrate deploy` against
# schema=public on the integration database.

# Session cookie signing secret (auth lane). Generate: openssl rand -hex 32
SESSION_SECRET="change-me"

# Hosted Postgres (integration/demo): Neon Postgres 16. Same DATABASE_URL
# shape; never commit the real URL. See docs/deploy.md.

# Dev fixture impersonation via the `x-dev-actor` header (dev actor switcher).
# Opt-in only: must be "1" AND NODE_ENV != production. Leave unset to require
# real login for every request.
# DEALFLOW_DEV_IMPERSONATION=1

# Krishna fixture adapter is local-only. Production must stay live (no fallback).
# Use `pnpm dev:fixture` / DEALFLOW_ADAPTER=development for the Krishna UI harness.
# DEALFLOW_ADAPTER=development

# Optional integrations (fail closed in production when a send/charge/SSO is attempted).
# APP_URL=http://localhost:3000
# RESEND_API_KEY=
# MAIL_FROM=DealFlow360 <noreply@nexa.example>
# MAIL_WEBHOOK_URL=
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# CRON_SECRET=change-me-cron
# JOBS_ACTOR_EMAIL=dev@nexa.example
# DEALFLOW_FX_JSON={"INR":1,"USD":83.5,"EUR":90}
# CARRIER_QUOTE_URL=
# CARRIER_API_KEY=
