{
  "files.exclude": {
    "**/.next": true,
    "**/node_modules": true,
    "**/.dealflow-development": true,
    "**/src/generated": true,
    "**/.turbo": true,
    "**/.vercel": true
  },
  "files.watcherExclude": {
    "**/.next/**": true,
    "**/node_modules/**": true,
    "**/.dealflow-development/**": true,
    "**/src/generated/**": true
  },
  "search.exclude": {
    "**/.next": true,
    "**/node_modules": true,
    "**/.dealflow-development": true,
    "**/src/generated": true
  },
  "git.repositoryScanIgnoredFolders": [
    ".next",
    "node_modules",
    "out",
    "dist",
    ".turbo",
    ".vercel",
    "src/generated"
  ]
}
